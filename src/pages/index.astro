---
import { Code as AstroCode } from 'astro:components'
import type { ComponentProps } from 'astro/types'
import { bundledLanguagesInfo } from 'shiki/langs'

import Code from '../components/Code.astro'
import '../styles/globals.scss'

const title = 'CodeShot'
const defaultCode = `
┌──────────────────────────────────────────┐
│                                          │
│   C O D E S H O T                        │
│   ────────────────────────────────────   │
│                                          │
│      ┌─────┐     ┌────────────────┐      │
│      │ </> │ ──▶ │  render(code)  │      │
│      └─────┘     │    CodeShot    │      │
│                  └────────────────┘      │
│                                          │
│   CODE IN.  CLEAN OUTPUT.                │
│   From raw code to a polished shot.      │
│                                          │
│   > Syntax highlighted by Astro          │
│   > Line numbered by CodeShot            │
│   > Loaded from code or a raw file URL   │
│                                          │
│   Example:                               │
│   /?url=https://akum.site/example-ts │
│                                          │
└──────────────────────────────────────────┘
`.trim()

const params = new URL(Astro.request.url).searchParams
const hasCode = params.has('code')
const hasUrl = params.has('url')
let sourceUrl: URL | undefined
let code = defaultCode
let error = ''

if (hasCode && hasUrl) error = 'Provide either "code" or "url", not both.'
else if (hasUrl) {
    sourceUrl = new URL(params.get('url')!)
    const response = await fetch(sourceUrl)
    if (!response.ok) throw new Error(`File request failed with status ${response.status}.`)
    code = await response.text()
} else if (hasCode) code = params.get('code')!

const lang = bundledLanguagesInfo.find(
    (language): language is typeof bundledLanguagesInfo[number] & {
        id: Extract<NonNullable<ComponentProps<typeof AstroCode>['lang']>, string>;
    } => [language.id, ...(language.aliases ?? [])].includes(params.get('lang') ?? sourceUrl?.pathname.match(/\.([a-zA-Z0-9_+-]+)$/)?.[1] ?? '')
)?.id ?? 'text'

---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="$waiting_on_description" />
        <meta name="keywords" content="$waiting_on_keywords" />
        <title>{title}</title>

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content="$waiting_on_og_description" />
        <meta property="og:image" content={`${Astro.site}${'$waiting_on_og_image'}`} />
        <meta property="og:site_name" content={title} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content="$waiting_on_twitter_description" />
        <meta property="twitter:image" content={`${Astro.site}${'$waiting_on_twitter_image'}`} />

        <link rel="icon" href="/assets/favicon.png" />
    </head>
    <body>
        <main class="content">
            <Code><AstroCode code={error || code} lang={error ? 'text' : lang} /></Code>
        </main>
    </body>
</html>
